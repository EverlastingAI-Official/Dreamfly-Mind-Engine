# Dependencies and package caches
node_modules/
.npm-cache/

# UniApp, Vite and TypeScript build output
dist/
unpackage/
.vite/
# Vite bundles config files beside the original during loading
vite.config.*.timestamp-*.mjs
vite.config.*.timestamp-*.js
*.tsbuildinfo

# Local environment and credentials (keep configuration examples)
.env
.env.*
!.env.example
!.env.*.example
secrets/

# Local TLS certificates and site-specific proxy overrides
/certs/
/deploy/certs/
/deploy/nginx/*.local.conf

# Runtime storage (including local PostgreSQL, dev logs and process registry)
data/
# Database and asset backups
backups/

# Locally exported application images (docker save)
/dreamfly-*.tar
/dreamfly-*.tar.gz

# Test coverage
coverage/
.nyc_output/

# Local tooling and reference material
.conda/
.venv/
/.references/

# Locally generated images, screenshots and export bundles
# Application assets under src/static/ (including avatars) belong in version control.
/output/

# Logs and temporary files
*.log
*.pid
*.pid.lock
*.tmp
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
