# Dependencies and package caches
node_modules/
.npm-cache/

# UniApp, Vite and TypeScript build output
dist/
unpackage/
.vite/
# Vite bundles config files beside the original during loading
vite.config.*.timestamp-*.mjs
vite.config.*.timestamp-*.js
*.tsbuildinfo

# Local environment and credentials (keep configuration examples)
.env
.env.*
!.env.example
!.env.production.example
secrets/

# Runtime storage (including local PostgreSQL, dev logs and process registry)
data/
# Database and asset backups
backups/

# Test coverage
coverage/
.nyc_output/

# Local tooling and reference material
.conda/
.venv/
/.references/

# Logs and temporary files
*.log
*.pid
*.pid.lock
*.tmp
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
