# Create a NEW website in BaoTa; do not replace pybackend's configuration.
# Domain supplied for this deployment: soulhub.world.
# Verify both certificate paths after issuing the site's certificate.
server {
    listen 80;
    server_name soulhub.world;
    # Keep BaoTa's ACME challenge location/include when issuing certificates.
    location / {
        return 301 https://soulhub.world$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name soulhub.world;
    ssl_certificate /www/server/panel/vhost/cert/soulhub.world/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/soulhub.world/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 55m;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
