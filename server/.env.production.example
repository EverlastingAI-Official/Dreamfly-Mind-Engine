# Used by compose.production.yaml. Domain is a placeholder until configured.
# Do not include a trailing slash or path in APP_ORIGIN.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=https://dreamfly.example.com
LOG_LEVEL=info
# Only the internal web proxy connects to API; it replaces X-Forwarded-For.
TRUST_PROXY=uniquelocal

PGHOST=db
PGPORT=5432
PGDATABASE=dreamfly
PGUSER=dreamfly
PGPASSWORD_FILE=/run/secrets/postgres_password
DB_POOL_MAX=5
ASSET_STORAGE_DIR=/app/data/assets

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=DreamFly <noreply@example.com>
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_SECRET_FILE=/run/secrets/email_code_secret

SESSION_COOKIE_NAME=__Host-dreamfly_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_IDLE_SECONDS=86400
SESSION_ABSOLUTE_SECONDS=604800

API_KEY_ENCRYPTION_KEY_VERSION=1
API_KEY_ENCRYPTION_KEY_FILE=/run/secrets/api_key_encryption_key
MODEL_TIMEOUT_SECONDS=120
MODEL_USER_MAX_CONCURRENCY=2
UPLOAD_JSON_MAX_BYTES=10485760
UPLOAD_ZIP_MAX_BYTES=52428800
UPLOAD_EXTRACTED_MAX_BYTES=104857600
UPLOAD_MAX_FILES=100

GITHUB_SYNC_ENABLED=false
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_OWNER_TOKEN_FILE=/run/secrets/github_owner_token
GITHUB_SYNC_TIMEZONE=Asia/Shanghai
GITHUB_SYNC_WEEKDAY=1
GITHUB_SYNC_TIME=03:00
WORKER_QUEUE=all
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_LEASE_SECONDS=120
