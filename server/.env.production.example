# Template for future API/worker containers; not wired into compose.yaml yet.
# Replace example.com and mount each referenced secret through Compose secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=https://mind.example.com
LOG_LEVEL=info

PGHOST=db
PGPORT=5432
PGDATABASE=dreamfly
PGUSER=dreamfly
PGPASSWORD_FILE=/run/secrets/postgres_password
DB_POOL_MAX=10
ASSET_STORAGE_DIR=/app/data/assets

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_FROM=DreamFly <noreply@example.com>
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_SECRET_FILE=/run/secrets/email_code_secret

SESSION_COOKIE_NAME=__Host-dreamfly_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_IDLE_SECONDS=86400
SESSION_ABSOLUTE_SECONDS=604800

API_KEY_ENCRYPTION_KEY_VERSION=1
API_KEY_ENCRYPTION_KEY_FILE=/run/secrets/api_key_encryption_key
MODEL_TIMEOUT_SECONDS=120
MODEL_USER_MAX_CONCURRENCY=2
UPLOAD_JSON_MAX_BYTES=10485760
UPLOAD_ZIP_MAX_BYTES=52428800
UPLOAD_EXTRACTED_MAX_BYTES=104857600
UPLOAD_MAX_FILES=100

GITHUB_SYNC_ENABLED=false
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_private_key
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
GITHUB_CALLBACK_URL=https://mind.example.com/api/v1/github/callback
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_LEASE_SECONDS=120
