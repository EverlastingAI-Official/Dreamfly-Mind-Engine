# Backend configuration. Run setup:local to copy this without overwriting existing values.
# Run the backend from the repository's server/ directory.
# Relative paths use that working directory.
# Node loads .env; the backend supports *_FILE for secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=dreamfly
PGUSER=dreamfly
PGPASSWORD_FILE=../secrets/postgres_password.txt
DB_POOL_MAX=10
ASSET_STORAGE_DIR=../data/assets

# Real SMTP only. Fill in your own sender and SMTP authorization code file.
# Check connectivity/authentication with npm run smtp:check; see docs/LOCAL_DEVELOPMENT.md.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=your-account@163.com
SMTP_PASSWORD_FILE=../secrets/smtp_password.txt
SMTP_FROM=DreamFly <your-account@163.com>
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_SECRET_FILE=../secrets/email_code_secret.txt

# HTTP development uses a different cookie name. Production requires __Host-*.
SESSION_COOKIE_NAME=dreamfly_session_dev
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_IDLE_SECONDS=86400
SESSION_ABSOLUTE_SECONDS=604800

API_KEY_ENCRYPTION_KEY_VERSION=1
API_KEY_ENCRYPTION_KEY_FILE=../secrets/api_key_encryption_key.txt
MODEL_TIMEOUT_SECONDS=120
MODEL_USER_MAX_CONCURRENCY=2
# Per-user provider API keys belong in encrypted PostgreSQL records, not this file.

UPLOAD_JSON_MAX_BYTES=10485760
UPLOAD_ZIP_MAX_BYTES=52428800
UPLOAD_EXTRACTED_MAX_BYTES=104857600
UPLOAD_MAX_FILES=100

GITHUB_SYNC_ENABLED=false
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET_FILE=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET_FILE=
GITHUB_CALLBACK_URL=http://localhost:5173/api/v1/github/callback
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_LEASE_SECONDS=120
