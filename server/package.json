{
  "name": "@dreamfly/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DreamFly multi-user Mind Skill API and background worker",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.0.0",
    "@octokit/auth-app": "^8.0.0",
    "@octokit/rest": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.0.0",
    "yaml": "^2.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.0.0",
    "@types/smtp-server": "^3.5.13",
    "@types/yauzl": "^2.10.0",
    "@types/yazl": "^2.4.0",
    "smtp-server": "^3.19.13",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "dev:mail": "node --env-file-if-exists=.env --import tsx scripts/dev-mail.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts"
  }
}
