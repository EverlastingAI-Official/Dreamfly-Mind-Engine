# Copy to .env. Never put API keys or passwords in VITE_* variables.
# API_PROXY_TARGET configures Vite; VITE_API_BASE_URL is consumed by src/services/platform.js.
# Keep this same-origin so session cookies and CSRF checks work.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:3001

# Infrastructure: compose.yaml at the repository root.
POSTGRES_DB=dreamfly
POSTGRES_USER=dreamfly
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
POSTGRES_LOCAL_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
